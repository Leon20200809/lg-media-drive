{
  "name": "leon20200809/lg-media-drive",
  "type": "project",
  "description": "Private media workspace for a small team.",
  "license": "proprietary",
  "require": {
    "php": "~8.3.37",
    "laravel/framework": "^13.0"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "bash tests/http-smoke.sh"
  },
  "config": {"optimize-autoloader": true, "sort-packages": true, "platform": {"php": "8.3.37"}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
